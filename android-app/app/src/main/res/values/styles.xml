<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AlphabetIndexStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#8E8E93</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingVertical">1dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="FriendFilterChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_filter_chip</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>