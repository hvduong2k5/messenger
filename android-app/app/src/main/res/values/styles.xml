<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AlphabetIndexStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#8E8E93</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingVertical">1dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="FriendFilterChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="FriendFilterChipSelected" parent="FriendFilterChip">
        <item name="android:background">@drawable/bg_filter_chip_selected</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FriendFilterChipUnselected" parent="FriendFilterChip">
        <item name="android:background">@drawable/bg_filter_chip</item>
        <item name="android:textColor">#8E8E93</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- Edit Profile Styles -->
    <style name="EditProfileLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="EditProfileInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/bg_edit_text_rounded</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">16sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="OtpBoxStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:background">@drawable/bg_otp_box</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:text">_</item>
        <item name="android:textColorHint">#8E8E93</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>